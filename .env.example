# =============================================================================
# OpenAI API Configuration
# =============================================================================
OPENAI_API_KEY=sk-your-api-key-here

# =============================================================================
# Embedding Configuration
# =============================================================================
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1024

# =============================================================================
# Agentic RAG Model Configuration
# =============================================================================
AGENT_WORKER_MODEL=gpt-5-mini
AGENT_REASONING_MODEL=gpt-5-mini
AGENT_CRITIC_MODEL=gpt-5-mini
AGENT_SUPERVISOR_MODEL=gpt-5-mini
AGENT_DATA_ANALYST_MODEL=gpt-5-mini

# --- Optional: per-role provider selection (src/agentic_rag/llm_factory.py) ---
# ROLE in: SUPERVISOR | WORKER | REASONING | CRITIC | DATA_ANALYST.
# Defaults preserve current behavior (provider=openai, key=OPENAI_API_KEY).
# Used by the model sweep (configs/model_sweep.example.yaml). Examples:
#   AGENT_SUPERVISOR_PROVIDER=openai        # openai | openai_compatible | anthropic
#   AGENT_SUPERVISOR_BASE_URL=              # required for openai_compatible endpoints
#   AGENT_SUPERVISOR_API_KEY_ENV=OPENAI_API_KEY   # NAME of the env var holding the key
#   AGENT_SUPERVISOR_TEMPERATURE=1.0
# ANTHROPIC_API_KEY=                        # needed only if a role uses provider=anthropic
# DEEPSEEK_API_KEY=                         # https://api-docs.deepseek.com (openai_compatible provider: deepseek)
# MOONSHOT_API_KEY=                         # Kimi, https://platform.kimi.ai/docs (openai_compatible provider: moonshot)
# MINIMAX_API_KEY=                          # https://platform.minimax.io/docs (openai_compatible provider: minimax)
# GEMINI_API_KEY=                           # Google AI Studio key; Gemini's OpenAI-compat endpoint (openai_compatible provider: gemini)
# DASHSCOPE_API_KEY=                        # Alibaba Cloud Qwen via DashScope compatible-mode (openai_compatible provider: qwen)
# ZAI_API_KEY=                              # Zhipu AI / z.ai GLM models, https://docs.z.ai (openai_compatible provider: glm)

# --- Explicit argument overrides (src/agentic_rag/llm_factory.py) ---
# All of the AGENT_<ROLE>_* vars above can also be passed directly as keyword
# arguments to resolve_role_config()/make_chat_model() -- e.g.
# make_chat_model("supervisor", provider="anthropic", model="claude-sonnet-5").
# An explicit argument wins over its env var for that call; omitting it falls
# back to the env var, then the built-in default. No env vars are required for
# this path -- it's how the model sweep can run multiple configs in one process
# without mutating os.environ (see src/evaluation/model_sweep.py
# build_run_kwargs / iter_run_kwargs).

# --- R11: premise verification (fictional-entity / unverifiable-premise hedging) ---
# 1 = on (default). Set 0 to A/B the feature against the hedging-FP gate.
SUPERVISOR_PREMISE_CHECK_ENABLED=1

# =============================================================================
# Database Paths
# =============================================================================
CHROMADB_DIR=./chromadb
EMBEDDINGS_CACHE_DB=data/embeddings_cache.duckdb
CHUNKS_DIR=data/loaded_chunks
DATA_ROOT=data

# =============================================================================
# Data Source Paths
# =============================================================================
CSB_DATA_DIR=data/processed/csb_olmocr
OSHA_DATA_DIR=data/processed/osha

# =============================================================================
# Chunking Configuration
# =============================================================================
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MAX_TOKENS_PER_CHUNK=800

# =============================================================================
# Chunk Validation Thresholds
# =============================================================================
CHUNK_TARGET_MIN_TOKENS=300
CHUNK_TARGET_MAX_TOKENS=800

# =============================================================================
# Batch Processing (OpenAI Batch API)
# =============================================================================
BATCH_FILES_DIR=data/batch_files
EMBEDDINGS_OUTPUT_DIR=data/embeddings_output
OPENAI_BATCH_SIZE=500
BATCH_MAX_REQUESTS=5000
BATCH_MAX_CONCURRENT=3
BATCH_POLL_INTERVAL_S=60
BATCH_TIMEOUT_MINUTES=120
BATCH_GLOBAL_TIMEOUT_MINUTES=2880
BATCH_RETRY_WAIT_S=120
BATCH_RETRY_MAX=5
BATCH_COMPLETION_WINDOW=24h
EMBEDDING_PRICE_PER_1K_TOKENS=0.000065

# =============================================================================
# ChromaDB Indexing
# =============================================================================
CHROMADB_BATCH_SIZE=1000
CHROMADB_DEFAULT_N_RESULTS=10

# =============================================================================
# Embeddings Metadata
# =============================================================================
EMBEDDINGS_VERSION=openai.t3l.1024@2025-11-12
EMBEDDINGS_SCHEMA_VERSION=1

# =============================================================================
# Model Pricing (USD per token, for cost estimation)
# =============================================================================
# Comprehensive pricing for all supported LLM providers.
# All prices are USD per 1M tokens (verified 2026-07-27). Override any model
# by setting MODEL_PRICING_JSON to a JSON dict, e.g.:
#   MODEL_PRICING_JSON={"my-model": {"prompt": 1e-06, "completion": 2e-06}}
#
# Reference links:
#   OpenAI:   https://openai.com/api/pricing/
#   Claude:   https://docs.anthropic.com/en/docs/about-claude/pricing
#   Gemini:   https://ai.google.dev/gemini-api/docs/pricing
#   MiniMax:  https://platform.minimax.io/docs/guides/pricing-paygo
#   DeepSeek: https://api-docs.deepseek.com/quick_start/pricing
#   Kimi:     https://platform.kimi.ai/docs/pricing/chat (+ chat-k3/chat-k26)
#   Qwen:     https://www.alibabacloud.com/help/en/model-studio/models (model ids
#             only, no $ pricing -- Qwen rows below are third-party-sourced)
#   GLM:      https://docs.z.ai (base_url/model id confirmed; pricing is third-party)
#
# Built-in pricing (no env var needed; these are the defaults). See
# src/data_processing/config.py for the authoritative dict and per-provider
# confidence notes.
#
# OpenAI                         Input/1M    Output/1M
# ─────────────────────────────  ─────────   ──────────
# gpt-5.6-sol (flagship, GA 07-09) $5.00       $30.00
# gpt-5.6-terra                   $2.50       $15.00
# gpt-5.6-luna                     $1.00       $ 6.00
# gpt-5.4                        $2.50       $15.00
# gpt-5.4-mini                   $0.75       $ 4.50
# gpt-5.3-codex                  $1.75       $14.00
# gpt-5.2-codex                  $1.75       $14.00
# gpt-5.2 / gpt-5.1 / gpt-5     $1.25       $10.00
# gpt-5-mini                     $0.25       $ 2.00
# gpt-5-nano                     $0.05       $ 0.40
# gpt-4.1                        $2.00       $ 8.00
# gpt-4.1-mini                   $0.40       $ 1.60
# gpt-4.1-nano                   $0.10       $ 0.40
# gpt-4o                         $2.50       $10.00
# gpt-4o-mini                    $0.15       $ 0.60
# o3                              $2.00       $ 8.00
# o4-mini                         $1.10       $ 4.40
#
# Anthropic Claude               Input/1M    Output/1M
# ─────────────────────────────  ─────────   ──────────
# claude-fable-5                   $10.00      $50.00
# claude-opus-5                     $5.00       $25.00
# claude-sonnet-5 (intro, thru 08-31) $2.00       $10.00
# claude-haiku-4-5                  $1.00       $ 5.00
# claude-opus-4 (prior gen)         $5.00       $25.00
# claude-sonnet-4 (prior gen)       $3.00       $15.00
# claude-haiku-4 (prior gen)        $1.00       $ 5.00
#
# Google Gemini                  Input/1M    Output/1M
# ─────────────────────────────  ─────────   ──────────
# gemini-3.6-flash                 $1.50       $ 7.50
# gemini-3.5-flash                 $1.50       $ 9.00
# gemini-3.5-flash-lite             $0.30       $ 2.50
# gemini-3.1-pro-preview           $2.00       $12.00
# gemini-3.1-flash-lite             $0.25       $ 1.50
# gemini-2.5-pro (likely deprecated) $1.25       $10.00
# gemini-2.5-flash (likely deprecated) $0.30       $ 2.50
# gemini-2.5-flash-lite (likely deprecated) $0.10       $ 0.40
#
# MiniMax                        Input/1M    Output/1M
# ─────────────────────────────  ─────────   ──────────
# minimax-m3                       $0.30       $ 1.20
# minimax-m2.7                    $0.30       $ 1.20
# minimax-m2.5                    $0.30       $ 1.20
# minimax-m2.1                    $0.30       $ 1.20
#
# DeepSeek                       Input/1M    Output/1M
# ─────────────────────────────  ─────────   ──────────
# deepseek-v4-flash (current)       $0.14       $ 0.28
# deepseek-v4-pro (current)         $0.435      $ 0.87
# deepseek-v3.2 / deepseek-v3    $0.28       $ 0.42
# deepseek-r1                     $0.55       $ 2.19
#
# Kimi (Moonshot AI)             Input/1M    Output/1M
# ─────────────────────────────  ─────────   ──────────
# kimi-k3 (flagship)               $3.00       $15.00
# kimi-k2.6 (current mid-tier)      $0.95       $ 4.00
# kimi-k2.5 (prior gen)             $0.60       $ 2.50
# kimi-k2 (prior gen)               $0.60       $ 2.50
#
# Qwen (Alibaba Cloud)          Input/1M    Output/1M
# ─────────────────────────────  ─────────   ──────────
# qwen3.7-max (3rd-party sourced)   $1.25       $ 3.75
# qwen3.7-flash (qwencloud.com, tiered by ctx) $0.03-0.20  $ 0.13-0.80
# qwen3-max                       $1.20       $ 6.00
# qwen-plus                       $0.40       $ 1.20
# qwen3-coder                     $0.30       $ 1.50
#
# GLM (Zhipu AI / z.ai)          Input/1M    Output/1M
# ─────────────────────────────  ─────────   ──────────
# glm-5.2                         $1.40       $ 4.40
# glm-5.1                          $0.966      $ 3.04
# glm-5                            $0.60       $ 1.92
#
# MODEL_PRICING_JSON=

# =============================================================================
# Agentic RAG Token Limits
# =============================================================================
SUPERVISOR_PLANNING_MAX_TOKENS=99999
SUPERVISOR_SYNTHESIS_MAX_TOKENS=2500
SUPERVISOR_REVISION_MAX_TOKENS=2500
REASONING_MAX_TOKENS=3000
WORKER_QUERY_REFORMULATION_MAX_TOKENS=99999
DATA_ANALYST_SQL_GENERATION_MAX_TOKENS=99999
DATA_ANALYST_SQL_VERIFICATION_MAX_TOKENS=99999
CRITIC_EVALUATION_MAX_TOKENS=400
CRITIC_QUANTITATIVE_MAX_TOKENS=300
EVAL_LLM_MAX_TOKENS=99999

# =============================================================================
# Agentic RAG Graph Control
# =============================================================================
MAX_CRITIC_RETRIES=2
VALIDATION_SCORE_THRESHOLD=0.8

# =============================================================================
# Agentic RAG Retrieval Tuning
# =============================================================================
HYBRID_VECTOR_TOP_K=10
HYBRID_KEYWORD_TOP_K=5
RRF_K=60
HYBRID_RERANK_TOP_N=10

# =============================================================================
# Agentic RAG LLM Temperature Defaults
# =============================================================================
# Leave these unset (commented out). src/agentic_rag/llm_factory.py now picks
# a provider-aware default per role: 1.0 for GPT-5-family models (gpt-5-mini
# and gpt-5-nano only accept temperature=1.0), 0.0 for everything else
# (DeepSeek and most other providers accept 0.0, which is what you want for a
# reproducible eval run). Only set one of these if you need to pin a role's
# temperature regardless of which model it resolves to.
# SUPERVISOR_TEMPERATURE=0.0
# CRITIC_TEMPERATURE=0.0
# WORKER_TEMPERATURE=0.0
# REASONING_TEMPERATURE=0.0

# =============================================================================
# Data Analyst Agent
# =============================================================================
SQL_MAX_RESULT_ROWS=1000
SQL_QUERY_TIMEOUT_S=30

# =============================================================================
# Data Collection Scrapers
# =============================================================================
CSB_BASE_URL=https://www.csb.gov
OSHA_ENFORCEMENT_BASE_URL=https://enforcedata.dol.gov
OSHA_REGULATIONS_BASE_URL=https://www.osha.gov
# SCRAPER_USER_AGENT=Mozilla/5.0 ...
SCRAPER_REQUEST_TIMEOUT=30
SCRAPER_SLEEP_DELAY=1
SCRAPER_REGULATION_SLEEP_DELAY=2
WEBDRIVER_WAIT_TIMEOUT=30
DOWNLOAD_CHUNK_SIZE=8192
LARGE_FILE_THRESHOLD=52428800
CSV_CHUNK_ROWS=10000
CSB_LINKS_FILENAME=csb_investigation_links.csv
CSB_DATA_FILENAME=csb_investigation_data.csv
OSHA_ENFORCEMENT_SUMMARY_FILENAME=osha_enforcement_data_summary.csv
OSHA_REGULATIONS_SUMMARY_FILENAME=osha_regulations_summary.json

# =============================================================================
# Evaluation Framework
# =============================================================================
EVAL_LLM_MODEL=gpt-5.4-mini
EVAL_LLM_TEMPERATURE=1.0
# --- Optional: judge provider selection (src/evaluation/judge_factory.py) ---
# Same mechanism/precedence as the AGENT_<ROLE>_* vars above, under role
# "eval_judge". Defaults preserve current behavior (provider=openai). Lets the
# RAGAS/DeepEval judge itself run on a different provider than the pipeline
# being evaluated (e.g. to cross-check whether two providers agree on scores).
# EVAL_LLM_PROVIDER=openai                  # openai | openai_compatible | anthropic
# EVAL_LLM_BASE_URL=                        # required for openai_compatible endpoints
# EVAL_LLM_API_KEY_ENV=OPENAI_API_KEY       # NAME of the env var holding the key
# RAGAS metrics that use embeddings configure them separately.
# EVAL_EMBEDDING_MODEL=text-embedding-3-small
# EVAL_EMBEDDING_API_KEY_ENV=OPENAI_API_KEY
# EVAL_EMBEDDING_BASE_URL=
EVAL_BOOTSTRAP_ITERATIONS=1000
EVAL_CONFIDENCE_LEVEL=0.95

# Dataset files are downloaded separately from the Hugging Face benchmark.
# Relative paths resolve from your working directory; absolute paths also work.
# EVAL_DATASET_DIR=data/evaluation
# EVAL_DATASET_FILE=data/evaluation/eval_dataset_v1.json
# EVAL_DATASET_FILE takes precedence for the main split only. The directory
# override also locates the adversarial split and evaluation outputs.
# These example model defaults are for framework use. For the paper's frozen
# Tier 1 / judge configuration, see the Zenodo bundle's docs/REPLICATION.md.

# Evaluation Metric Thresholds
EVAL_THRESHOLD_CONTEXT_PRECISION=0.85
EVAL_THRESHOLD_CONTEXT_RECALL=0.75
EVAL_THRESHOLD_HIT_RATE_AT_5=0.80
EVAL_THRESHOLD_MRR=0.70
EVAL_THRESHOLD_NDCG_AT_5=0.75
EVAL_THRESHOLD_FAITHFULNESS=0.90
EVAL_THRESHOLD_HALLUCINATION_RATE=0.05
EVAL_THRESHOLD_ANSWER_CORRECTNESS=0.80
EVAL_THRESHOLD_FACTUAL_CORRECTNESS=0.85
EVAL_THRESHOLD_CITATION_ACCURACY=0.95
EVAL_THRESHOLD_GOAL_ACCURACY=0.85
EVAL_THRESHOLD_TOOL_CALL_ACCURACY=0.90
EVAL_THRESHOLD_TOPIC_ADHERENCE=0.95
EVAL_THRESHOLD_CRITIC_SCORE_MEAN=0.80
EVAL_THRESHOLD_RETRY_RATE=0.20
EVAL_THRESHOLD_SQL_EXECUTION_SUCCESS=0.95
EVAL_THRESHOLD_SQL_CORRECTNESS=0.85
EVAL_THRESHOLD_SQL_CORRECTNESS_RELAXED=0.90
EVAL_THRESHOLD_NUMERICAL_FIDELITY=0.98
EVAL_THRESHOLD_HYBRID_SYNTHESIS_QUALITY=0.80

# Evaluation Generator Defaults
EVAL_GENERATOR_SEED=42
EVAL_GENERATOR_MIN_TOKEN_COUNT=50
EVAL_GENERATOR_CHECKPOINT_EVERY=10

# Evaluation Runtime
EVAL_MAX_WORKERS=4
EVAL_WORKER_TIMEOUT=120
EVAL_MAX_CONCURRENT=3
EVAL_RETRIEVAL_K=5
EVAL_DEDUP_SIMILARITY_THRESHOLD=0.95
EVAL_DEDUP_EMBEDDING_MODEL=text-embedding-3-small
DEEPEVAL_PER_ATTEMPT_TIMEOUT_SECONDS_OVERRIDE=180

# =============================================================================
# Web UI Server (src/web, src/agentic_rag_web)
# =============================================================================
# make web and python -m src.web read these settings from the environment and .env.
# CPS_WEB_PORT=8001 make web
# CPS_WEB_HOST=127.0.0.1
# CPS_WEB_PORT=8000
# CPS_WEB_REQUIRE_TOKEN=0
# Set a random token before LAN access or CPS_WEB_REQUIRE_TOKEN=1.
# CPS_WEB_ACCESS_TOKEN=
# CPS_WEB_MAX_CONCURRENCY=3
# CPS_WEB_DAILY_SPEND_CEILING_USD=20.0
# The ceiling uses recorded estimates. In-flight work can exceed it.
# Web and CLI history default to logs/ under the working directory.
# CPS_PROJECT_ROOT=/absolute/path/to/local/workspace
# CPS_CONDENSE_ROLE=worker
